# Copia este archivo a .env y ajusta los valores (.env NO se sube al repositorio).

# Desarrollo local: True. Producción: False.
DEBUG=True

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto

# Separados por comas. En Render se agrega solo RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes del frontend si se aloja en otro dominio (opcional)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Usuario de demostración (comando crear_demo)
DEMO_USER=demo
DEMO_PASSWORD=pon-aqui-una-contrasena

# PostgreSQL (lo crea docker compose con estos valores)
DB_NAME=api_tareas
DB_USER=postgres
DB_PASSWORD=pon-aqui-la-clave-de-postgres
DB_HOST=localhost
DB_PORT=5433

# Alternativa: una sola URL. Si se define, tiene prioridad sobre DB_* (Render la usa).
# DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
